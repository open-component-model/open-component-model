# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# ocm CLI images, two targets:
# - slim: scratch with ocm and the Garden Linux FIPS CA bundle (--target slim).
# - full (default): slim plus cosign built against the Go Cryptographic Module.
#
# full copies /ocm from the "slim" stage, so both images carry the identical
# binary. To build full around an already published slim image instead, pass
#   --build-context slim=docker-image://ghcr.io/open-component-model/cli:<version>-slim

FROM --platform=${BUILDPLATFORM} ghcr.io/gardenlinux/gardenlinux/fips:1877.25@sha256:74ae1f81d0723434024f591d8c2872852201b99b9f18c0fbe10221b16e60e01d AS certs

FROM scratch AS slim
ARG TARGETOS
ARG TARGETARCH
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY tmp/bin/ocm-${TARGETOS}-${TARGETARCH} /ocm
ENTRYPOINT ["/ocm"]

# cosign is built from source because upstream release binaries are not linked
# against the Go Cryptographic Module.
FROM --platform=${BUILDPLATFORM} golang:1.27.1@sha256:162be5298a40ed317005c8339c6de4d10d3eef336d66dc8e9259b03ab9d3a6d2 AS cosign
ARG TARGETOS
ARG TARGETARCH
# Source of truth: bindings/go/sigstore/signing/handler/internal/.env
ARG COSIGN_VERSION
# Source of truth: root .env
ARG GOFIPS140
# go install refuses GOBIN for cross-compiles; the binary lands in /go/bin or
# /go/bin/${GOOS}_${GOARCH} depending on whether host and target match.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOTOOLCHAIN=local \
    GOFIPS140="${GOFIPS140:?GOFIPS140 build arg is required, see root .env}" \
    GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go install -trimpath -ldflags="-s -w" \
      "github.com/sigstore/cosign/v3/cmd/cosign@${COSIGN_VERSION:?COSIGN_VERSION build arg is required}" \
    && mkdir -p /out && find /go/bin -name cosign -type f -exec cp {} /out/cosign \;

FROM scratch AS full
# scratch defines no PATH; ocm looks up cosign on PATH.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# No GODEBUG needed: GOFIPS140 already makes fips140=on the default of both
# ocm and cosign (DefaultGODEBUG in their build info).
COPY --from=cosign /out/cosign /usr/local/bin/cosign
COPY --from=slim /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# /ocm keeps the path of the previous scratch image for COPY --from users.
COPY --from=slim /ocm /ocm
ENTRYPOINT ["/ocm"]

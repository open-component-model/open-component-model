# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# ocm CLI images, two targets:
# - slim: scratch with ocm and the Garden Linux FIPS CA bundle (--target slim).
# - full (default): Garden Linux FIPS userland on bare-libc, GnuPG on Garden
#   Linux's FIPS-capable libgcrypt, and cosign built against the Go
#   Cryptographic Module, plus ocm taken from the slim image.
#
# full copies /ocm from the "slim" stage, so both images carry the identical
# binary. To build full around an already published slim image instead, pass
#   --build-context slim=docker-image://ghcr.io/open-component-model/cli:<version>-slim

# CA bundle from the Garden Linux FIPS image, plus world-writable /tmp and the
# default cache directories under HOME=/ (Docker's HOME for a user without a
# passwd entry): /.cache for OCM's caches and a downloaded cosign, /.sigstore
# for cosign's trust root. Files only, so this runs on the build platform.
FROM --platform=$BUILDPLATFORM ghcr.io/gardenlinux/gardenlinux/fips:1877.25@sha256:74ae1f81d0723434024f591d8c2872852201b99b9f18c0fbe10221b16e60e01d AS certs
RUN mkdir -p /out/etc/ssl/certs \
 && cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/ \
 && mkdir -m 1777 /out/tmp /out/.cache /out/.sigstore

FROM scratch AS slim
ARG TARGETOS
ARG TARGETARCH
COPY --from=certs /out /
COPY tmp/bin/ocm-${TARGETOS}-${TARGETARCH} /ocm
USER 65532:65532
ENTRYPOINT ["/ocm"]

# cosign is built from source because upstream release binaries are not linked
# against the Go Cryptographic Module.
FROM --platform=${BUILDPLATFORM} golang:1.27.1@sha256:162be5298a40ed317005c8339c6de4d10d3eef336d66dc8e9259b03ab9d3a6d2 AS cosign
ARG TARGETOS
ARG TARGETARCH
# Source of truth: bindings/go/sigstore/signing/handler/internal/.env
ARG COSIGN_VERSION
# Source of truth: root .env
ARG GOFIPS140
# go install refuses GOBIN for cross-compiles; the binary lands in /go/bin or
# /go/bin/${GOOS}_${GOARCH} depending on whether host and target match.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOTOOLCHAIN=local \
    GOFIPS140="${GOFIPS140:?GOFIPS140 build arg is required, see root .env}" \
    GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go install -trimpath -ldflags="-s -w" \
      "github.com/sigstore/cosign/v3/cmd/cosign@${COSIGN_VERSION:?COSIGN_VERSION build arg is required}" \
    && mkdir -p /out && find /go/bin -name cosign -type f -exec cp {} /out/cosign \;

# GnuPG comes from the Garden Linux FIPS image because its libgcrypt is the
# FIPS-capable build. The image itself is a full distro (apt, shell), so gpg and
# exactly its shared libraries are staged into /rootfs and copied into bare-libc.
# Keep this image and bare-libc (full stage) on the SAME Garden Linux release:
# the staged gpg libraries run under bare-libc's dynamic loader. Renovate updates
# both in one PR (group "Garden Linux images" in .github/renovate.json5).
FROM ghcr.io/gardenlinux/gardenlinux/fips:1877.25@sha256:74ae1f81d0723434024f591d8c2872852201b99b9f18c0fbe10221b16e60e01d AS gpg
# gpg-agent is needed for signing; verification only needs gpg.
# dirmngr: gpgconf --show-versions exits non-zero without it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gpg gpg-agent gpgconf dirmngr \
    && rm -rf /var/lib/apt/lists/*
# Paths are canonicalised (Garden Linux is usrmerged: /lib -> usr/lib) so the
# staged tree never replaces the symlinks already present in bare-libc.
RUN set -eu; \
    # ocm runs gpgconf --show-versions to check that libgcrypt is in FIPS mode
    # and gpgconf --kill (via gpg-connect-agent) to stop its temporary agents.
    bins="/usr/bin/gpg /usr/bin/gpg-agent /usr/bin/gpgconf /usr/bin/gpg-connect-agent /usr/bin/dirmngr"; \
    for f in $bins $(ldd $bins | awk '$2 == "=>" {print $3}' | sort -u); do \
      dst="/rootfs$(readlink -f "$(dirname "$f")")"; \
      mkdir -p "$dst" && cp -L "$f" "$dst/"; \
    done; \
    # libgcrypt enters FIPS mode when this file exists (its content is not
    # read); there is no kernel fips=1 to rely on inside a container.
    mkdir -p /rootfs/etc/gcrypt; \
    echo 1 > /rootfs/etc/gcrypt/fips_enabled

FROM ghcr.io/gardenlinux/gardenlinux/bare-libc:1877.25@sha256:ea38f985cd155f7a36389da0952cc0f95609d013d4bceffd7a522f3758b954f0 AS full
COPY --from=gpg /rootfs/ /
# No GODEBUG needed: GOFIPS140 already makes fips140=on the default of both
# ocm and cosign (DefaultGODEBUG in their build info).
COPY --from=cosign /out/cosign /usr/local/bin/cosign
COPY --from=certs /out /
# /ocm keeps the path of the previous scratch image for COPY --from users.
COPY --from=slim /ocm /ocm
USER 65532:65532
ENTRYPOINT ["/ocm"]

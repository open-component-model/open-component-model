# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# ocm CLI images, two targets:
# - slim: scratch with ocm and the Garden Linux FIPS CA bundle (--target slim).
# - full (default): slim plus the prebuilt FIPS cosign image.
#
# full copies /ocm from the "slim" stage, so both images carry the identical
# binary. To build full around an already published slim image instead, pass
#   --build-context slim=docker-image://ghcr.io/open-component-model/cli:<version>-slim

# Garden Linux FIPS image: source of the CA bundle, which the images copy by
# its path so nothing else from this image reaches them.
FROM --platform=$BUILDPLATFORM ghcr.io/gardenlinux/gardenlinux/fips:1877.25@sha256:74ae1f81d0723434024f591d8c2872852201b99b9f18c0fbe10221b16e60e01d AS certs

FROM scratch AS slim
ARG TARGETOS
ARG TARGETARCH
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY tmp/bin/ocm-${TARGETOS}-${TARGETARCH} /ocm
USER 65532:65532
# WORKDIR creates missing directories owned by USER: /tmp and the default
# cache directory under HOME=/ (Docker's HOME for a user without a passwd
# entry), /.cache for OCM's caches. Only UID 65532 can write to them.
WORKDIR /tmp
WORKDIR /.cache
WORKDIR /
ENTRYPOINT ["/ocm"]

# Static cosign linked against the Go Cryptographic Module (GOFIPS140=certified,
# fips140=on by default), built and published from
# https://github.com/open-component-model/cosign. Same release as COSIGN_VERSION in
# bindings/go/sigstore/signing/handler/internal/.env (Renovate group "OCM cosign";
# pin_sync_test.go there fails if they diverge).
FROM ghcr.io/open-component-model/cosign:v3.1.4-ocm.2@sha256:abc86b4330048abfaa2b92578ce384e14667eb3e5f2e75bbd244ae940362f541 AS cosign

FROM scratch AS full
# scratch defines no PATH; ocm looks up cosign on PATH.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# No GODEBUG needed: GOFIPS140 already makes fips140=on the default of both
# ocm and cosign (DefaultGODEBUG in their build info).
COPY --from=cosign /cosign /usr/local/bin/cosign
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# /ocm keeps the path of the previous scratch image for COPY --from users.
COPY --from=slim /ocm /ocm
USER 65532:65532
# Writable directories as in slim, plus /.sigstore for cosign's trust root.
WORKDIR /tmp
WORKDIR /.cache
WORKDIR /.sigstore
WORKDIR /
ENTRYPOINT ["/ocm"]

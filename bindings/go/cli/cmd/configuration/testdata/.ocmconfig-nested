type: generic.config.ocm.software/v1
configurations:
- type: credentials.config.ocm.software
  consumers:
  - identity:
      type: OCIRegistry
      hostname: ghcr.io
    credentials:
    - type: Credentials/v1
      properties:
        username: "ghcr-user"
        password: "ghcr-token"
- type: generic.config.ocm.software/v1
  configurations:
  - type: attributes.config.ocm.software
    attributes:
      cache: ~/.ocm/cache
- type: generic.config.ocm.software
  configurations:
  - type: attributes.config.ocm.software
    attributes:
      cache: ~/.ocm/legacy-cache
- type: generic.config.ocm.software/v1
  configurations:
  - type: attributes.config.ocm.software
    attributes:
      cache: ~/.ocm/future-cache

# Retry transient network failures when curl fetches sigstore assets (scaffolding scripts,
# the kind binary, Knative and sigstore release YAMLs, cosign). A CI runner can lose its
# connection to github.com for a short time (curl exit 28). Without retries, one failure
# stops the whole integration setup. CURL_HOME (set on the scaffolding:setup and cosign:install
# tasks) applies this file to their curls and the upstream scaffolding scripts they run. None
# of those curls pass -q.
# Do not add retry-all-errors here. After a partial transfer it can resend data, and some
# curls in this Taskfile pipe their output into kubectl.
# fail: upstream setup-kind.sh fetches the Knative manifests with `curl -L -s | yq` (no -f).
# Without it, a retried 5xx writes the error page and then the YAML into the same pipe.
connect-timeout = 30
fail
retry = 5
retry-connrefused
retry-max-time = 300

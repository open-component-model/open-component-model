# Retry transient network failures when curl fetches sigstore assets (scaffolding scripts,
# the kind binary, Knative and sigstore release YAMLs, cosign). A CI runner can lose its
# connection to github.com for a short time (curl exit 28). Without retries, one failure
# stops the whole integration setup. CURL_HOME (set in the Taskfile) applies this file to
# every curl in the Taskfile and in the upstream scaffolding scripts. None of them pass -q.
# Do not add retry-all-errors here. After a partial transfer it can resend data, and some
# curls in this Taskfile pipe their output into kubectl.
connect-timeout = 30
retry = 5
retry-connrefused
retry-max-time = 300

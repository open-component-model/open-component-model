NAME=open-component-model
ORG=open-component-model
REPO=github.com/open-component-model/open-component-model
TASK_X_ENV_PRECEDENCE=1

# Go Cryptographic Module (FIPS 140-3) linked into every OCM binary and used by
# the test suites. "certified" selects the latest module version with a CMVP
# certificate (currently v1.0.0), so builds move to a newer module automatically
# once the Go toolchain marks it certified; see https://go.dev/doc/security/fips140
# and website/content/docs/reference/standards-and-regulations/fips.md.
GOFIPS140=certified

# OpenSCAP with the Chainguard GPOS SRG profile, used by .github/scripts/stig-scan.js.
# renovate: datasource=docker depName=cgr.dev/chainguard/openscap
OPENSCAP_IMAGE=cgr.dev/chainguard/openscap:latest-dev@sha256:0fb079dc00bf183f3f630f7f443f28461f55dae3cd3dcf24d12112dac063df38

# Benchmark scanners used by .github/workflows/image-scan.yml: dockle (CIS Docker
# Benchmark) on the images, Kubescape (NSA/CISA, MITRE) on the rendered chart.
# renovate: datasource=docker depName=goodwithtech/dockle
DOCKLE_IMAGE=goodwithtech/dockle:v0.4.15@sha256:eade932f793742de0aa8755406c7677cd7696f8675b6180926f7eeffa7abe6b9
# renovate: datasource=docker depName=quay.io/kubescape/kubescape-cli
KUBESCAPE_IMAGE=quay.io/kubescape/kubescape-cli:v4.0.15@sha256:16f1383351936d4085f9eec4a01a08abe34e531629d2e849d3893aaed2c74052

# Tool versions
# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCI_LINT_VERSION=v2.13.2

# renovate: datasource=go depName=k8s.io/code-generator
DEEPCOPY_GEN_VERSION=v0.37.0

# renovate: datasource=npm depName=markdownlint-cli2
MARKDOWNLINT_CLI2_VERSION=0.23.2

# renovate: datasource=go depName=gotest.tools/gotestsum
GOTESTSUM_VERSION=v1.13.0

# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.8.0
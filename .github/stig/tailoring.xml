<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tailors the Chainguard GPOS SRG profile (shipped in the digest-pinned
  cgr.dev/chainguard/openscap image) for OCM's static scratch images. The
  deselected rules check Wolfi-specific files that these images do not contain.
  Rule IDs carry the SRG revision, so an SRG update in a new openscap image
  fails the scan until this list is updated.
-->
<Tailoring xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_software.ocm_tailoring_gpos-container">
  <benchmark href="/usr/share/xml/scap/ssg/content/ssg-chainguard-gpos-ds.xml"/>
  <version time="2026-10-03T00:00:00">1</version>
  <Profile id="xccdf_software.ocm_profile_gpos-container" extends="xccdf_basic_profile_.check">
    <title>GPOS SRG for OCM images</title>
    <description>Chainguard GPOS SRG profile without the rules that check Wolfi-specific files.</description>
    <!-- OpenSSL FIPS provider: OCM's binaries use the Go Cryptographic Module (GOFIPS140). -->
    <select idref="xccdf_mil.disa.stig_rule_SV-203649r971535_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203739r987791_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203750r958912_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203751r958914_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203776r959006_rule" selected="false"/>
    <!-- Wolfi CA bundle digests: the bundle comes from the pinned Garden Linux image. -->
    <select idref="xccdf_mil.disa.stig_rule_SV-263659r982563_rule" selected="false"/>
    <!-- Shared library permissions and user installation of software: the images
         are static and have no package manager. -->
    <select idref="xccdf_mil.disa.stig_rule_SV-203675r991560_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203716r982210_rule" selected="false"/>
    <!-- /var/log permissions: logs go to stdout/stderr. -->
    <select idref="xccdf_mil.disa.stig_rule_SV-203616r958434_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203617r958436_rule" selected="false"/>
    <select idref="xccdf_mil.disa.stig_rule_SV-203664r958566_rule" selected="false"/>
  </Profile>
</Tailoring>

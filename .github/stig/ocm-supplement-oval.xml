  <definitions>
    <definition class="compliance" id="oval:software.ocm:def:1" version="1">
      <metadata>
        <title>Entrypoint is built against a frozen Go Cryptographic Module in FIPS mode</title>
        <description>The Go build information of the entrypoint binary records GOFIPS140=v&lt;version&gt; and a DefaultGODEBUG that enables fips140. OVAL file probes stop at the first NUL byte and cannot read a binary, so stig-scan.js reads both build settings from the entrypoint and passes them as variables.</description>
      </metadata>
      <criteria operator="AND">
        <criterion test_ref="oval:software.ocm:tst:1" comment="GOFIPS140 names a frozen module version"/>
        <criterion test_ref="oval:software.ocm:tst:2" comment="DefaultGODEBUG enables fips140"/>
      </criteria>
    </definition>
    <definition class="compliance" id="oval:software.ocm:def:2" version="1">
      <metadata>
        <title>Only the pinned CA bundle is installed</title>
        <description>/etc/ssl/certs/ca-certificates.crt matches the CA bundle of the pinned base image, and no other certificate files exist.</description>
      </metadata>
      <criteria operator="AND">
        <criterion test_ref="oval:software.ocm:tst:3" comment="CA bundle digest matches the base image"/>
        <criterion test_ref="oval:software.ocm:tst:4" comment="no other certificate files"/>
      </criteria>
    </definition>
    <definition class="compliance" id="oval:software.ocm:def:3" version="1">
      <metadata>
        <title>Static root filesystem</title>
        <description>No shared libraries or dynamic loader, no package manager, no setuid/setgid files, no world-writable files or directories without the sticky bit, and no executable other than the entrypoint.</description>
      </metadata>
      <criteria operator="AND">
        <criterion test_ref="oval:software.ocm:tst:5" comment="no shared libraries or dynamic loader"/>
        <criterion test_ref="oval:software.ocm:tst:6" comment="no package manager binaries"/>
        <criterion test_ref="oval:software.ocm:tst:7" comment="no package databases"/>
        <criterion test_ref="oval:software.ocm:tst:8" comment="no setuid files"/>
        <criterion test_ref="oval:software.ocm:tst:9" comment="no setgid files"/>
        <criterion test_ref="oval:software.ocm:tst:10" comment="no world-writable files"/>
        <criterion test_ref="oval:software.ocm:tst:11" comment="no world-writable directories without the sticky bit"/>
        <criterion test_ref="oval:software.ocm:tst:12" comment="no executable other than the entrypoint"/>
      </criteria>
    </definition>
    <definition class="compliance" id="oval:software.ocm:def:4" version="1">
      <metadata>
        <title>No on-disk logs</title>
        <description>The image has no /var/log and no log files.</description>
      </metadata>
      <criteria operator="AND">
        <criterion test_ref="oval:software.ocm:tst:13" comment="no /var/log"/>
        <criterion test_ref="oval:software.ocm:tst:14" comment="no log files"/>
      </criteria>
    </definition>
  </definitions>

